<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.physanto.opsecengine</groupId>
        <artifactId>opsec-padre</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>opsec-oraculos</artifactId>

    <name>OpSecEngine - Oráculos</name>
    <description>Oráculos incluidos que deciden hallazgos a partir de la traza.</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-dominio</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-soporte-pruebas</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../contratos/esquemas</directory>
                <targetPath>io/github/physanto/opsecengine/oraculos/esquemas</targetPath>
                <includes>
                    <include>oraculo-regla.schema.json</include>
                    <include>traza-evento.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../contratos/catalogos</directory>
                <targetPath>io/github/physanto/opsecengine/oraculos/catalogos</targetPath>
                <includes>
                    <include>oraculos.yaml</include>
                    <include>cwe.yaml</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
