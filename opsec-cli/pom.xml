<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.physanto.opsecengine</groupId>
        <artifactId>opsec-padre</artifactId>
        <version>0.0.6</version>
    </parent>

    <artifactId>opsec-cli</artifactId>

    <name>OpSecEngine - CLI</name>
    <description>Interfaz de línea de comandos del motor (comando opsec).</description>

    <properties>
        <opsec.cli.jar>${project.build.directory}/opsec-${project.version}.jar</opsec.cli.jar>
        <!-- Este módulo sí puede escribir en la consola -->
        <checkstyle.consola.severidad>ignore</checkstyle.consola.severidad>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-nucleo</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <!-- Oráculos y reporteros: el núcleo los descubre con ServiceLoader; la CLI no los usa en el código -->
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-oraculos</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-informes</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Jar del agente: se copia como recurso dentro de la CLI. Se declara solo para que el
                 reactor lo construya antes; se excluye del classpath de las pruebas -->
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-agente</artifactId>
            <classifier>agente</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- App de práctica para DemoIT, que ejecuta la demo de demo/. Se declara solo para que
                 el reactor la construya antes; se excluye del classpath de las pruebas -->
            <groupId>${project.groupId}</groupId>
            <artifactId>opsec-clientes-vulnerable</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Envía los mensajes de SLF4J de las librerías a java.util.logging -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Copia el jar del agente como recurso de la CLI, antes de empaquetar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>agente-como-recurso</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>opsec-agente</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>agente</classifier>
                                    <destFileName>opsec-agente.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.outputDirectory}/io/github/physanto/opsecengine/cli</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Jar ejecutable con todas las dependencias: java -jar target/opsec-<versión>.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jar-ejecutable</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Archivo aparte: el jar normal del módulo no cambia -->
                            <outputFile>${opsec.cli.jar}</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${project.groupId}.cli.ComandoOpsec</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>${project.groupId}:opsec-agente</classpathDependencyExclude>
                        <classpathDependencyExclude>${project.groupId}:opsec-clientes-vulnerable</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <!-- Pruebas de integración (*IT): ejecutan el jar empaquetado en otra JVM -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>${project.groupId}:opsec-agente</classpathDependencyExclude>
                        <classpathDependencyExclude>${project.groupId}:opsec-clientes-vulnerable</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <systemPropertyVariables>
                        <opsec.cli.jar>${opsec.cli.jar}</opsec.cli.jar>
                        <opsec.demo>${project.basedir}/../demo</opsec.demo>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
